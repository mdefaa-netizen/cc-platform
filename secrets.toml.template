# .streamlit/secrets.toml
# Copy this file to .streamlit/secrets.toml and fill in your values
# DO NOT commit this file to GitHub — add it to .gitignore

APP_PASSWORD  = "CHANGE_ME_BEFORE_FIRST_RUN"

# Optional: if set, the app uses the Postgres/Supabase backend instead of SQLite.
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"

# Optional: if set, the bootstrap coordinator uses this password instead of
# generating a random one. Remove after first login.
# BOOTSTRAP_PASSWORD = "change-me-on-first-login"

SMTP_HOST     = "smtp.gmail.com"
SMTP_PORT     = "587"
SMTP_USER     = "your_gmail@gmail.com"
SMTP_PASSWORD = "your_16char_app_password"
FROM_EMAIL    = "your_gmail@gmail.com"

# Optional: if set, the Mileage calculator (pages/7_Payments.py) and the
# facilitator portal's travel estimate use the Google Maps Distance Matrix API
# for exact driving distance. If unset, the app falls back to a free
# OpenStreetMap/Haversine estimate.
# GOOGLE_MAPS_API_KEY = "AIza..."
